# Template for the .env file that lives next to docker-compose.yml ON THE SERVER.
# Copy to .env, fill in real values, `chmod 600 .env`. Never commit the real one.
#
# NEXT_PUBLIC_* are read twice: once at build time (inlined into the browser
# bundle) and once at runtime (next.config.ts rewrites). Both paths are covered
# because docker-compose passes them as build args AND via env_file.

# --- which backend to talk to ---
NEXT_PUBLIC_API_ENV=production
NEXT_PUBLIC_API_URL_PROD=https://api.mailsfinder.com
NEXT_PUBLIC_SERVER_URL=https://api.mailsfinder.com
NEXT_PUBLIC_APP_URL=https://app.mailsfinder.com

# Only used when NEXT_PUBLIC_API_ENV is staging/local. Safe to leave blank in prod.
NEXT_PUBLIC_API_URL_STAGING=
NEXT_PUBLIC_API_URL_LOCAL=
NEXT_PUBLIC_LOCAL_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CORE_API_BASE=
NEXT_PUBLIC_BACKEND_SIGNUP_PATH=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Runtime only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- LemonSqueezy (all SECRET, runtime only) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_ANNUAL_VARIANT_ID=
LEMONSQUEEZY_LIFETIME_VARIANT_ID=
LEMONSQUEEZY_PAYG_10K_VARIANT_ID=
LEMONSQUEEZY_PAYG_22K_VARIANT_ID=
LEMONSQUEEZY_PAYG_42K_VARIANT_ID=
LEMONSQUEEZY_PAYG_100K_VARIANT_ID=
LEMONSQUEEZY_PAYG_250K_VARIANT_ID=

# --- misc ---
NEXT_PUBLIC_WHATSAPP_COMMUNITY_LINK=
